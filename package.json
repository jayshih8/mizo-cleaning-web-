{
  "name": "mizo-cleaning-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && vite",
    "build": "node scripts/prepare-content.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs && node scripts/check-seo.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test": "node --test tests/*.test.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.4",
    "vite": "^8.1.0"
  }
}
