{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.tbcleanpro.com" }], "destination": "https://tbcleanpro.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "mizo-cleaning-web.vercel.app" }], "destination": "https://tbcleanpro.com/:path*", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/admin", "destination": "/admin-portal", "permanent": true }
  ],
  "headers": [
    { "source": "/admin-portal", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/404", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/media/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] }
  ]
}